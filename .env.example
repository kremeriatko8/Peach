# --- database ---
POSTGRES_USER=peach
POSTGRES_PASSWORD=peach
POSTGRES_DB=peach
POSTGRES_PORT=5432

# --- backend ---
DATABASE_URL=postgresql+asyncpg://peach:peach@db:5432/peach
BACKEND_PORT=8000
APP_ENV=development
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:3000

# Backend JWT verification uses public configuration, never Google secrets/tokens.
# make backend-auth-config writes these to gitignored backend/.env.auth.local.
# Production deployment reads the same values from auth outputs + trusted JWKS.
# COGNITO_AUTHORITY=
# COGNITO_CLIENT_ID=
# COGNITO_JWKS_JSON=

# --- frontend ---
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000
INTERNAL_API_URL=http://backend:8000

# --- aws (make deploy-backend / deploy-frontend / domain) ---
# Everything lands in us-east-1, tagged PROJECT_NAME=<PROJECT_NAME>. Every
# other knob has a default in the scripts or templates and can still be set
# here to override it.
AWS_REGION=us-east-1
PROJECT_NAME=peach
# Blank keys fall back to AWS_PROFILE, SSO, or an instance role.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_PROFILE=

# The deployed frontend's origin, once it has one.
API_CORS_ORIGINS=*

# --- Cognito: make deploy-auth reads these; never expose Google credentials ---
# Blank placeholders only. Store real credentials in gitignored root .env.
COGNITO_DOMAIN_PREFIX=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional; defaults to ${PROJECT_NAME}-auth.
AUTH_STACK_NAME=
# Optional; defaults to ${PROJECT_NAME}-migrations.
MIGRATION_STACK_NAME=
# Public auth values are generated in frontend/.env.local by make auth-config.
# Do not set them here: deployed builds obtain them from stack outputs.
# NEXT_PUBLIC_COGNITO_AUTHORITY=
# NEXT_PUBLIC_COGNITO_CLIENT_ID=
# NEXT_PUBLIC_COGNITO_DOMAIN=
# NEXT_PUBLIC_AUTH_REDIRECT_URI=
# NEXT_PUBLIC_AUTH_LOGOUT_URI=

# --- written by the scripts, not by hand ---
# make deploy-backend: the function URL. make deploy-frontend builds against it.
BACKEND_URL=
# make domain DOMAIN=app.example.com: the frontend's custom domain.
DOMAIN_NAME=

# Explicit verified manual Aurora snapshot for a controlled backend release.
# Public identifier only; do not set until the snapshot is available.
PEACH_RELEASE_SNAPSHOT_ID=
