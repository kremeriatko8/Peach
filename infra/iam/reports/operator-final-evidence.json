{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadOnlyScopedReportCSVs",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::peach-reports-968053399627-us-east-1/reports/__REPORT_SCOPE_ID__/*.csv"
    },
    {
      "Sid": "VerifyReportDeliveryState",
      "Effect": "Allow",
      "Action": "dynamodb:GetItem",
      "Resource": "arn:aws:dynamodb:us-east-1:968053399627:table/peach-report-mail-state"
    }
  ]
}
