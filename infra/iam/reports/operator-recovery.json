{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "InspectAndDeleteReviewedFailureMessages",
      "Effect": "Allow",
      "Action": [
        "sqs:ReceiveMessage",
        "sqs:GetQueueAttributes",
        "sqs:DeleteMessage",
        "sqs:ChangeMessageVisibility"
      ],
      "Resource": [
        "arn:aws:sqs:us-east-1:968053399627:peach-report-builder-dlq",
        "arn:aws:sqs:us-east-1:968053399627:peach-report-scheduler-dlq",
        "arn:aws:sqs:us-east-1:968053399627:peach-report-mailer-failures"
      ]
    },
    {
      "Sid": "BuilderDlqRedrive",
      "Effect": "Allow",
      "Action": [
        "sqs:StartMessageMoveTask",
        "sqs:CancelMessageMoveTask",
        "sqs:ListMessageMoveTasks"
      ],
      "Resource": "arn:aws:sqs:us-east-1:968053399627:peach-report-builder-dlq"
    },
    {
      "Sid": "ReplayCorrectedReportPayload",
      "Effect": "Allow",
      "Action": "sqs:SendMessage",
      "Resource": "arn:aws:sqs:us-east-1:968053399627:peach-report-work"
    },
    {
      "Sid": "ReplayOnlyMailerRequestPayload",
      "Effect": "Allow",
      "Action": "lambda:InvokeFunction",
      "Resource": "arn:aws:lambda:us-east-1:968053399627:function:peach-report-mailer"
    },
    {
      "Sid": "PauseBuilderConsumption",
      "Effect": "Allow",
      "Action": "lambda:UpdateEventSourceMapping",
      "Resource": "arn:aws:lambda:us-east-1:968053399627:event-source-mapping:*",
      "Condition": {
        "ArnEquals": {
          "lambda:FunctionArn": "arn:aws:lambda:us-east-1:968053399627:function:peach-report-builder"
        }
      }
    },
    {
      "Sid": "ControlledReportingStackRecovery",
      "Effect": "Allow",
      "Action": [
        "cloudformation:DeleteStack",
        "cloudformation:ContinueUpdateRollback"
      ],
      "Resource": "arn:aws:cloudformation:us-east-1:968053399627:stack/peach-reports/*"
    }
  ]
}
