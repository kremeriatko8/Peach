{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "PassOnlyReportingExecutionRole",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::968053399627:role/peach-reports-cfn-exec",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "cloudformation.amazonaws.com"
        }
      }
    }
  ]
}
