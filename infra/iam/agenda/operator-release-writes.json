{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": [
        "cloudformation:CreateChangeSet",
        "cloudformation:ExecuteChangeSet",
        "cloudformation:DeleteChangeSet"
      ],
      "Resource": [
        "arn:aws:cloudformation:us-east-1:968053399627:stack/peach-backend/*",
        "arn:aws:cloudformation:us-east-1:968053399627:stack/peach-migrations/*",
        "arn:aws:cloudformation:us-east-1:968053399627:stack/peach-frontend/*",
        "arn:aws:cloudformation:us-east-1:968053399627:stack/peach-ai/*",
        "arn:aws:cloudformation:us-east-1:968053399627:stack/peach-budget/*"
      ]
    },
    {
      "Effect": "Allow",
      "Action": [
        "ecr:GetAuthorizationToken"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "ecr:BatchCheckLayerAvailability",
        "ecr:InitiateLayerUpload",
        "ecr:UploadLayerPart",
        "ecr:CompleteLayerUpload",
        "ecr:PutImage"
      ],
      "Resource": "arn:aws:ecr:us-east-1:968053399627:repository/peach-backend"
    },
    {
      "Effect": "Allow",
      "Action": [
        "lambda:UpdateFunctionCode",
        "lambda:UpdateFunctionConfiguration",
        "lambda:TagResource",
        "lambda:UntagResource"
      ],
      "Resource": [
        "arn:aws:lambda:us-east-1:968053399627:function:peach-backend",
        "arn:aws:lambda:us-east-1:968053399627:function:peach-migrations"
      ]
    },
    {
      "Effect": "Allow",
      "Action": [
        "lambda:InvokeFunction"
      ],
      "Resource": "arn:aws:lambda:us-east-1:968053399627:function:peach-migrations"
    },
    {
      "Effect": "Allow",
      "Action": [
        "iam:PassRole"
      ],
      "Resource": "arn:aws:iam::968053399627:role/peach-backend-ExecutionRole-PWplj0iyaN28",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "lambda.amazonaws.com"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "iam:GetRole",
        "iam:GetRolePolicy",
        "iam:ListRolePolicies",
        "iam:ListAttachedRolePolicies",
        "iam:ListRoleTags"
      ],
      "Resource": "arn:aws:iam::968053399627:role/peach-backend-ExecutionRole-PWplj0iyaN28"
    },
    {
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:DeleteObject"
      ],
      "Resource": "arn:aws:s3:::peach-frontend-968053399627-us-east-1/*"
    },
    {
      "Effect": "Allow",
      "Action": [
        "cloudfront:CreateInvalidation"
      ],
      "Resource": "arn:aws:cloudfront::968053399627:distribution/E13PELWU9NKJR8"
    },
    {
      "Effect": "Allow",
      "Action": [
        "rds:CreateDBClusterSnapshot"
      ],
      "Resource": [
        "arn:aws:rds:us-east-1:968053399627:cluster:peach-db",
        "arn:aws:rds:us-east-1:968053399627:cluster-snapshot:peach-pre-ownership-*"
      ]
    },
    {
      "Effect": "Allow",
      "Action": [
        "budgets:ModifyBudget",
        "budgets:TagResource",
        "budgets:UntagResource",
        "budgets:ListTagsForResource"
      ],
      "Resource": "arn:aws:budgets::968053399627:budget/peach-monthly-cost-alert"
    },
    {
      "Effect": "Allow",
      "Action": [
        "logs:PutRetentionPolicy",
        "logs:GetDataProtectionPolicy"
      ],
      "Resource": "arn:aws:logs:us-east-1:968053399627:log-group:/aws/lambda/peach-migrations:*"
    },
    {
      "Effect": "Allow",
      "Action": [
        "logs:TagResource",
        "logs:UntagResource",
        "logs:ListTagsForResource"
      ],
      "Resource": "arn:aws:logs:us-east-1:968053399627:log-group:/aws/lambda/peach-migrations"
    },
    {
      "Effect": "Allow",
      "Action": [
        "rds:AddTagsToResource"
      ],
      "Resource": "arn:aws:rds:us-east-1:968053399627:cluster-snapshot:peach-pre-ownership-*"
    }
  ]
}
