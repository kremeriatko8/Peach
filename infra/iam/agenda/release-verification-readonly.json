{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReviewExactAgendaChangeSet",
      "Effect": "Allow",
      "Action": [
        "cloudformation:DescribeChangeSet",
        "cloudformation:GetTemplate"
      ],
      "Resource": [
        "arn:aws:cloudformation:us-east-1:968053399627:stack/peach-ai/*",
        "arn:aws:cloudformation:us-east-1:968053399627:changeSet/agenda-*/*"
      ]
    },
    {
      "Sid": "ReadParserOnly",
      "Effect": "Allow",
      "Action": [
        "lambda:GetFunction",
        "lambda:GetFunctionConfiguration",
        "lambda:GetFunctionConcurrency"
      ],
      "Resource": "arn:aws:lambda:us-east-1:968053399627:function:peach-agenda-parser"
    }
  ]
}
