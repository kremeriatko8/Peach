{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadVersionsOfExistingMigrationFunctions",
      "Effect": "Allow",
      "Action": "lambda:ListVersionsByFunction",
      "Resource": [
        "arn:aws:lambda:us-east-1:968053399627:function:peach-agenda-parser",
        "arn:aws:lambda:us-east-1:968053399627:function:peach-report-builder",
        "arn:aws:lambda:us-east-1:968053399627:function:peach-report-mailer"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Sid": "ReadRegionalEndpointPrefixListMetadata",
      "Effect": "Allow",
      "Action": "ec2:DescribePrefixLists",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Sid": "ReadExistingPoolClientsForBrandingImport",
      "Effect": "Allow",
      "Action": "cognito-idp:ListUserPoolClients",
      "Resource": "arn:aws:cognito-idp:us-east-1:968053399627:userpool/us-east-1_bs7cWxhJp",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    }
  ]
}
