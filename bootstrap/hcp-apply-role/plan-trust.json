{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "HcpPeachDevPlanPhaseOnly",
      "Effect": "Allow",
      "Principal": {
        "Federated": "arn:aws:iam::968053399627:oidc-provider/app.terraform.io"
      },
      "Action": "sts:AssumeRoleWithWebIdentity",
      "Condition": {
        "StringEquals": {
          "app.terraform.io:aud": "aws.workload.identity"
        },
        "StringLike": {
          "app.terraform.io:sub": "organization:ooad-kremeriatko8:project:*:workspace:peach-dev:run_phase:plan"
        }
      }
    }
  ]
}
